{
  "name": "dsh-lan-relay",
  "version": "1.1.0",
  "description": "DeepSeek Harness 局域网中继插件：一台机器在 DSH 进程内做 hub，其余机器粘贴加入码即可加入；跨机器 Agent 消息互通、离线补投、自动唤醒会话，标准 DSH bundle，装完即用。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "hub.mjs",
    "scripts/allow-firewall.ps1",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "hub": "node hub.mjs",
    "test": "node --test test/hub-core.test.mjs test/plugin.test.mjs test/client.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "lan",
    "relay",
    "message-bus",
    "multi-agent",
    "agent-to-agent",
    "wake-on-message"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ready-player-zero/dsh-lan-relay.git"
  },
  "homepage": "https://github.com/ready-player-zero/dsh-lan-relay#readme",
  "bugs": {
    "url": "https://github.com/ready-player-zero/dsh-lan-relay/issues"
  },
  "author": "ready-player-zero",
  "license": "MIT"
}
